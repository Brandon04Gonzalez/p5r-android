<?xml version="1.0" encoding="utf-8"?>
<!-- Persona 4 Arena Ultimax: a NativeActivity (all code in libp4au.so, android_main) behind a home screen with the options
     (games/p4au/java: Launcher.java, which writes config.txt). The game data (analysis/, extract/romfs/, spirv/ from the
     player's own dump) lives in Internal storage/Persona 4 Arena Ultimax, which needs all-files access. A private build for the
     owner of the game: never published. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.p4aurecomp"
    android:versionCode="6"
    android:versionName="0.3.3">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Vulkan 1.1: the mid-range GPUs the port targets (Adreno 610, PowerVR BXM) have nothing newer. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="P4AU"
        android:requestLegacyExternalStorage="true"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:isGame="true"
        android:appCategory="game"
        android:largeHeap="true"
        android:theme="@style/Fullscreen">
        <!-- Home screen: data check, options (config.txt), then the game. -->
        <activity
            android:name=".Launcher"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The import on the phone: only while the game is being prepared, in its own process so the native harness
             (C# NativeAOT, Ryujinx Maxwell shader translator) does not share state or memory with the game. -->
        <activity
            android:name=".ImportActivity"
            android:exported="false"
            android:process=":import"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="sensorLandscape" />
        <!-- Where the on-screen controls go (NX_TOUCH_LAYOUT), full screen like the game. -->
        <activity
            android:name=".ControlsEditor"
            android:exported="false"
            android:theme="@style/Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <!-- The game. Exported: test runs start it directly (games/p4au/tools/run_android.ps1). -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="p4au" />
        </activity>
        <provider
            android:name=".LogProvider"
            android:authorities="io.github.p4aurecomp.logprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
