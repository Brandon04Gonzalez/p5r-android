<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen, drawing under the camera cutout so the game gets the whole panel (2340x1080 on a Galaxy S23). -->
    <style name="Fullscreen" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
